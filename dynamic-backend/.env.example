# Copy to .env and edit. All values are optional (sensible defaults shown).

# Port the server listens on.
PORT=3000

# Public base URL users will scan. MUST be the real hostname you expose,
# e.g. https://qr.yourdomain.com — the app encodes this + the code into the QR.
BASE_URL=https://qr.yourdomain.com

# Shared secret. Send it from the Kuiqr app as the `x-api-key` header.
# Leave empty ONLY for local dev (the API will be open).
API_KEY=change-me-to-a-long-random-string

# SQLite file path. Use ":memory:" for a throwaway test instance.
DB_PATH=./data/qr.db

# Set to "true" to make /api/codes/:id/stats public (no key needed).
PUBLIC_STATS=false

# Short code length (base62).
CODE_LENGTH=7
