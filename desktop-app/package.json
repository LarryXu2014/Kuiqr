{
  "name": "kuiqr",
  "version": "2.4.1",
  "description": "Scan QR codes anywhere on your screen with a global keyboard shortcut. Works on Windows, macOS, and Linux.",
  "main": "main.js",
  "author": "LarryXu",
  "homepage": "https://github.com/LarryXu2014/Kuiqr",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux AppImage --x64",
    "build:linux-arm": "electron-builder --linux AppImage --arm64",
    "build:linux-deb": "electron-builder --linux deb --x64",
    "build:linux-deb-arm": "electron-builder --linux deb --arm64",
    "build:all": "electron-builder --mac --win --linux"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.kuiqr.app",
    "productName": "Kuiqr",
    "buildVersion": "2.4.2.3",
    "extraMetadata": {
      "buildVersion": "2.4.2.3"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "jsQR.js",
      "renderer/**/*",
      "overlay.html",
      "overlay-preload.js",
      "icons/**/*"
    ],
    "extraResources": [
      {
        "from": "native/qr-vision",
        "to": "native/qr-vision",
        "filter": ["**/*"]
      }
    ],
    "artifactName": "Kuiqr-${buildVersion}-mac-${arch}.${ext}",
    "mac": {
      "identity": null,
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "icons/icon512.png"
    },
    "win": {
      "artifactName": "Kuiqr-${buildVersion}-windows-x64.${ext}",
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "icons/icon512.png"
    },
    "linux": {
      "artifactName": "Kuiqr-${buildVersion}-linux-${arch}.${ext}",
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "deb", "arch": ["x64", "arm64"] }
      ],
      "icon": "icons/icon512.png",
      "category": "Utility",
      "maintainer": "Kuiqr",
      "description": "Scan QR codes anywhere on your screen with a global keyboard shortcut.",
      "synopsis": "Screen-region QR code scanner with a global hotkey."
    }
  }
}
